{
  "name": "student-lms-experience",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=200 vite dev --port 3002",
    "build": "ENABLE_REDIS=false NODE_OPTIONS=--max_old_space_size=6144 vite build",
    "start": "node .output/server/index.mjs",
    "pm2:start": "pm2 startOrRestart ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop student-lms",
    "pm2:delete": "pm2 delete student-lms",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:format": "prettier --check .",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "sync:masai-styles": "node ./scripts/sync-masai-styles.mjs",
    "prepare": "husky",
    "seed": "tsx seed/runner/cli.ts",
    "seed:all": "tsx seed/runner/cli.ts all",
    "seed:catalog": "tsx seed/catalog/generate.ts",
    "db:pull": "drizzle-kit pull && node scripts/sync-schema.mjs && prettier --write src/db/schema.ts"
  },
