# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Local database (see docker-compose.yml + `npm run db:setup`)
# ---------------------------------------------------------------------------
# These MYSQL_* values are consumed by docker-compose.yml and the db scripts.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lms_dev_db
MYSQL_PORT=3306

# Connection string used by the app (src/db/index.ts). Must match the values
# above. Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:root@localhost:3306/lms_dev_db"

# ---------------------------------------------------------------------------
# Redis (optional — caches + distributed locks; see src/server/redis/*)
# ---------------------------------------------------------------------------
# OFF by default: with ENABLE_REDIS unset/false the app never connects and every
# cache/lock degrades to the live DB path (no behaviour change). Set to 'true'
# only where a Redis instance is provisioned. If you point at the SAME instance
# as experience-api, keep db distinct or rely on our separate key prefixes.
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# Bounded TTL (seconds) for the lecture video-attendance eligibility cache.
# student-lms can't see experience-api's section-settings edits, so this caps
# staleness rather than trusting a deadline-derived TTL. Default 600 (10 min).
LECTURE_ELIGIBILITY_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# App runtime (fill in as needed for the features you work on)
# ---------------------------------------------------------------------------
NODE_ENV=development
COOKIE_NAME=
VITE_OLD_STUDENT_UI_URL=
JWT_SECRET_KEY=

# HS256 secret used to sign the ZEF (zoom.masaischool.com) redirect token.
# MUST match the value the deployed experience-api / ZEF proxy validates against,
# otherwise the proxy rejects the token ("verifying token" fails) and the client
# falls back to the standard zoom.us join link. Do NOT wrap the value in quotes.
ZOOM_REDIRECTION_JWT_SECRET=

# AI tutor (optional — only needed when working on that feature)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# AWS (optional — used by secrets/SSM lookups when running against AWS)
AWS_REGION=ap-south-1
AWS_PROFILE=

# Supabase (server-side admin client — e.g. syncing the profile avatar).
# SUPABASE_SERVICE_ROLE_KEY is a SECRET: it is intentionally NOT prefixed
# VITE_/NEXT_PUBLIC_ (those mark values as client-exposed) and is read only from
# server code (src/server/supabase/**). Same underlying credentials as
# experience-api (which names them NEXT_PUBLIC_* — a misnomer for a secret).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admissions portal (T0 onboarding: SSO redirects + external document status).
# ADMISSIONS_SSO_* mint the JWT redirect for kit-details / document-upload forms
# (also used by referral). ADMISSIONS_API_* fetch external document status; if
# unset, document status degrades gracefully (upload link still works).
ADMISSIONS_SSO_BASE_URL=
ADMISSIONS_SSO_SECRET=
ADMISSIONS_API_BASE_URL=
ADMISSIONS_API_KEY=

# experience-api origin. Used for server-to-server calls (community notify, etc.)
# and as the Assess Platform callback host (see below). Must be PUBLICLY
# reachable so the external Assess Platform can call it back.
EXPERIENCE_API_BASE_URL=

# Assess Platform (assignment assessment + AI-interview URL generation).
# Native calls to the external Assess Platform (createAssessPlatformUrl.ts):
# generate the test/interview URL, exclude already-attempted questions, and push
# tokens for showProblemSolution. Copy these values from experience-api.
#   - ASSESS_PLATFORM_URL: base URL of the Assess Platform API.
#   - ASSESS_PLATFORM_AUTH_TOKEN: `adminauthtoken` header on every call.
#   - ASSESS_PLATFORM_SECRET_KEY: `client_secret_key` in the generate-test payload.
#   - ASSESS_PLATFORM_CALLBACK_TOKEN: presence-checked guard (parity w/ experience-api).
#   - ASSESS_LMS_CLIENT_ID: `clientId` header for the token-push (showProblemSolution).
# The assessment callback URLs are built as EXPERIENCE_API_BASE_URL + "/graphql"
# (experience-api's GQL_BASE_URL) — so EXPERIENCE_API_BASE_URL must be the
# PUBLICLY reachable experience-api origin (the Assess Platform calls it back at
# /graphql/lms-callback, /graphql/live-progress-callback, /graphql/lms-ai-interview-callback).
# The post-assessment redirect base (`{url}/assignments/:id`) reuses the existing
# VITE_NEW_STUDENT_UI_URL / VITE_NEW_STUDENT_UI_URL_IHUB (via ORIGIN_URLS) — no
# assess-specific frontend var needed.
ASSESS_PLATFORM_URL=
ASSESS_PLATFORM_AUTH_TOKEN=
ASSESS_PLATFORM_SECRET_KEY=
ASSESS_PLATFORM_CALLBACK_TOKEN=
ASSESS_LMS_CLIENT_ID=
