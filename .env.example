# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Local database (see docker-compose.yml + `npm run db:setup`)
# ---------------------------------------------------------------------------
# These MYSQL_* values are consumed by docker-compose.yml and the db scripts.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lms_dev_db
MYSQL_PORT=3306

# Connection string used by the app (src/db/index.ts). Must match the values
# above. Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:root@localhost:3306/lms_dev_db"


# ---------------------------------------------------------------------------
# App runtime (fill in as needed for the features you work on)
# ---------------------------------------------------------------------------
NODE_ENV=development
COOKIE_NAME=
VITE_OLD_STUDENT_UI_URL=
JWT_SECRET_KEY=

# AI tutor (optional — only needed when working on that feature)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# AWS (optional — used by secrets/SSM lookups when running against AWS)
AWS_REGION=ap-south-1
AWS_PROFILE=
