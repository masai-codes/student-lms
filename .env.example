# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.
#
# ---------------------------------------------------------------------------
# HOW ENV WORKS HERE
# ---------------------------------------------------------------------------
# student-lms is a SINGLE full-stack TanStack Start app (one build, Nitro
# node-server). There is no separate frontend/backend deploy. The split is:
#
#   * VITE_* vars      -> baked into the CLIENT bundle at BUILD time and
#                         exposed to the browser. Never put secrets here.
#   * everything else  -> SERVER-only, read from process.env at RUNTIME.
#
# In production the runtime env is assembled by ecosystem.config.cjs from
# /home/ubuntu/app/.env.production (static) + .env.production.local (secrets
# pulled from AWS Secrets Manager by AfterInstall.sh).
#
# ONE build serves BOTH the `masai` and `ihub` portals; the origin is detected
# from the request host at runtime, so every origin's URL vars must be set.
#
# Legend:  [required]  [required for ihub]  [optional]  [dev-only]  [secret]


# ===========================================================================
# FRONTEND — VITE_* (build-time, exposed to the browser)
# ===========================================================================
# Per-origin app URLs. `masai` (default origin) uses the unprefixed vars;
# other origins use an _<ORIGIN> suffix (see src/utils/originUrls.ts). These
# have hardcoded fallbacks but you should set them explicitly for correct
# portal routing. VITE_*_STUDENT_UI_URL vars are also read from process.env at
# runtime (process.env first, then the baked import.meta.env value).
VITE_NEW_STUDENT_UI_URL=            # [required]        masai v2 (this) app base URL
VITE_OLD_STUDENT_UI_URL=            # [required]        masai legacy app base URL
VITE_NEW_STUDENT_UI_URL_IHUB=       # [required-ihub]   ihub v2 (this) app base URL
VITE_OLD_STUDENT_UI_URL_IHUB=       # [required-ihub]   ihub legacy app base URL

# 'true'/'false' — enables redirect from v2 back to the legacy student app.
VITE_ENABLE_LEGACY_STUDENT_REDIRECT=false   # [optional]

VITE_BUG_REPORT_FORM=               # [optional]  bug-report form link
VITE_SSM_AWS_SECRET_NAME=           # [optional]  AWS SSM secret name for lookups


# ===========================================================================
# BACKEND — server-only (runtime process.env)
# ===========================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development                # set to `production` by PM2 in prod
PORT=3002                           # 3002 local / 3000 in prod (set by PM2)

# Local database (see docker-compose.yml + `npm run db:setup`). MYSQL_* are
# consumed by docker-compose.yml + db scripts; DATABASE_URL by the app
# (src/db/index.ts). Format: mysql://<user>:<pass>@<host>:<port>/<database>
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lms_dev_db
MYSQL_PORT=3306
DATABASE_URL="mysql://root:root@localhost:3306/lms_dev_db"   # [required] [secret]

JWT_SECRET_KEY=                     # [required] [secret]  session JWT signing
COOKIE_NAME=                        # [required]  session cookie name
NEW_COOKIE_NAME=                    # [optional]  fallback for COOKIE_NAME

# experience-api origin. Used for server-to-server calls (community notify etc.)
# and as the Assess Platform callback host. Must be PUBLICLY reachable so the
# external Assess Platform can call it back at /graphql/*-callback.
EXPERIENCE_API_BASE_URL=            # [required]

# ---------------------------------------------------------------------------
# Auth / SSO / login
# ---------------------------------------------------------------------------
SSO_JWT_SECRET=                     # [required] [secret]  SSO token signing
SECRET_LOGIN_TOKEN=                 # [optional] [secret]  secret/impersonation login guard
SECRET_LOGIN_REDIRECT_URL=          # [optional]
IHUB_ORIGINS=                       # [optional]  comma-separated ihub origins
TESTING_IHUB_LOCALHOST=false        # [dev-only]  'true' to simulate ihub locally

# ---------------------------------------------------------------------------
# Admissions portal (T0 onboarding: SSO redirects + external document status)
# ---------------------------------------------------------------------------
# ADMISSIONS_SSO_* mint the JWT redirect for kit-details / document-upload forms
# (also used by referral). ADMISSIONS_API_* fetch external document status; if
# unset, document status degrades gracefully (upload link still works).
ADMISSIONS_SSO_BASE_URL=            # [required]        SSO frontend base (serves /lms-login)
ADMISSIONS_SSO_SECRET=              # [required] [secret]
ADMISSIONS_API_BASE_URL=            # [optional]        admissions backend (code appends /lms/...)
ADMISSIONS_API_KEY=                 # [optional]

# ---------------------------------------------------------------------------
# Assess Platform (assignment assessment + AI-interview URL generation)
# ---------------------------------------------------------------------------
# Native calls to the external Assess Platform (createAssessPlatformUrl.ts).
# Copy these values from experience-api. The assessment callback URLs are built
# as EXPERIENCE_API_BASE_URL + "/graphql", so that var must be publicly reachable.
#   - ASSESS_PLATFORM_URL:            base URL of the Assess Platform API.
#   - ASSESS_PLATFORM_AUTH_TOKEN:     `adminauthtoken` header on every call.
#   - ASSESS_PLATFORM_SECRET_KEY:     `client_secret_key` in the generate-test payload.
#   - ASSESS_PLATFORM_CALLBACK_TOKEN: presence-checked guard (parity w/ experience-api).
#   - ASSESS_LMS_CLIENT_ID:           `clientId` header for token-push (showProblemSolution).
ASSESS_PLATFORM_URL=
ASSESS_PLATFORM_AUTH_TOKEN=         # [secret]
ASSESS_PLATFORM_SECRET_KEY=         # [secret]
ASSESS_PLATFORM_CALLBACK_TOKEN=     # [secret]
ASSESS_LMS_CLIENT_ID=

# ---------------------------------------------------------------------------
# AWS / S3 / CDN
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=coding-platform
AWS_ACCESS_KEY_ID=                  # [optional] [secret]  omit to use AWS_PROFILE / instance role
AWS_SECRET_ACCESS_KEY=              # [optional] [secret]
AWS_PROFILE=                        # [optional]
AWS_SESSION_TOKEN=                  # [optional] [secret]
AWS_S3_CERTIFICATE_BUCKET_NAME=     # [optional]  falls back to AWS_S3_BUCKET_NAME
AWS_S3_UPLOAD_PREFIX=               # [optional]

# Alternate S3 credentials/config (take precedence for certain S3 clients).
S3_ACCESS_KEY_ID=                   # [optional] [secret]
S3_SECRET_ACCESS_KEY=               # [optional] [secret]
S3_REGION=                          # [optional]
S3_SESSION_TOKEN=                   # [optional] [secret]

# Certificates
S3_CERTIFICATE_TEMPLATES_URI=       # [optional]
CERTIFICATE_TEMPLATES_S3_URI=       # [optional]
CERTIFICATE_VERIFY_BASE_URL=        # [optional]

# CDN base (no trailing slash), e.g. cdn.masaischool.com
CLOUD_FRONT_BASE=                   # [optional]

# ---------------------------------------------------------------------------
# Redis (optional — caches + distributed locks; see src/server/redis/*)
# ---------------------------------------------------------------------------
# OFF by default: with ENABLE_REDIS unset/false the app never connects and every
# cache/lock degrades to the live DB path (no behaviour change). Set to 'true'
# only where a Redis instance is provisioned. If you point at the SAME instance
# as experience-api, keep db distinct or rely on our separate key prefixes.
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# Bounded TTL (seconds) for the lecture video-attendance eligibility cache.
# student-lms can't see experience-api's section-settings edits, so this caps
# staleness rather than trusting a deadline-derived TTL. Default 600 (10 min).
LECTURE_ELIGIBILITY_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# AI tutor / RAG (optional — only needed when working on that feature)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=                  # [secret]
ANTHROPIC_MODEL=
OPENAI_API_KEY=                     # [secret]
AI_CHAT_OPENAI_TIMEOUT_MS=
RAG_PLATFORM_BASE_URL=
RAG_PLATFORM_API_KEY=               # [secret]
RAG_PLATFORM_COLLECTION_NAME=
AI_TUTOR_RAG_INGEST_SECRET=         # [secret]  guards the RAG ingest endpoint

# ---------------------------------------------------------------------------
# Mock interviews (/interviews — optional, only needed when working on that feature)
# ---------------------------------------------------------------------------
# Everything routes through OpenRouter's OpenAI-compatible endpoint. The
# opening greeting/question and every turn (hears the answer + asks the
# follow-up in one call) go to an audio-input/audio-output model; the final
# report is a separate plain text-in/text-out grading call — deliberately a
# different, non-audio model, since an all-typed/all-transcribed interview
# would give the audio model no audio anywhere in input or output, which it
# rejects outright. One OPENROUTER_API_KEY covers both. See clients/openRouter*.ts.
OPENROUTER_API_KEY=                 # [secret]
INTERVIEW_AUDIO_MODEL=              # [optional]  default openai/gpt-audio-mini — must support input_audio + spoken audio output (modalities:['text','audio'], stream:true); used for the opening greeting/question and every turn
INTERVIEW_REPORT_MODEL=             # [optional]  default openai/gpt-5.6-luna — plain text model for final report grading; must NOT require audio input/output
INTERVIEW_MAX_ANSWER_SECONDS=       # [optional]  default 120 — caps recorded answer length client- and server-side

# Experimental switch: transcribe the candidate's answer live client-side via
# OpenAI's gpt-4o-mini-transcribe (over a direct browser<->OpenAI WebRTC
# connection, authenticated with a short-lived client secret our server
# mints — see clients/openaiRealtimeClient.ts) instead of sending the raw
# recording to the audio-in model above. The transcript is then sent as text
# to gpt-audio-mini for the spoken reply, same as a typed answer. Reuses the
# existing OPENAI_API_KEY (used elsewhere for the AI tutor) server-side only —
# it never reaches the browser. Unset/any other value keeps the default
# audio-in/audio-out flow.
VITE_INTERVIEW_STT_PROVIDER=        # [optional]  set to "openai-transcribe" to try the live-STT flow

# ---------------------------------------------------------------------------
# Supabase (server-side admin client — e.g. syncing the profile avatar)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY is a SECRET: intentionally NOT prefixed VITE_/
# NEXT_PUBLIC_ (those mark values as client-exposed) and read only from server
# code (src/server/supabase/**). Same underlying credentials as experience-api
# (which names them NEXT_PUBLIC_* — a misnomer for a secret).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # [secret]

# ---------------------------------------------------------------------------
# Notifications / messaging
# ---------------------------------------------------------------------------
OTP_2FACTOR_API_KEY=                # [optional] [secret]  OTP SMS
# Per-origin WhatsApp (Serri) keys, accessed by name at runtime. The plain
# WHATSAPP_SERRI_API_KEY acts as a fallback.
WHATSAPP_SERRI_API_KEY=             # [optional] [secret]
WHATSAPP_SERRI_API_KEY_MASAI=       # [optional] [secret]
WHATSAPP_SERRI_API_KEY_IHUB=        # [optional] [secret]
EXPO_ACCESS_TOKEN=                  # [optional] [secret]  push notifications
COMMUNITY_MASAIVERSE_INTERNAL_SECRET=   # [optional] [secret]  community notify (server-to-server)
SUPPORT_FALLBACK_ASSIGNEE_ID=1      # [optional]  default support ticket assignee

# ---------------------------------------------------------------------------
# Live lectures / Zoom / LiveKit
# ---------------------------------------------------------------------------
# HS256 secret used to sign the ZEF (zoom.masaischool.com) redirect token.
# MUST match the value the deployed experience-api / ZEF proxy validates against,
# otherwise the proxy rejects the token and the client falls back to the standard
# zoom.us join link. Do NOT wrap the value in quotes.
ZOOM_REDIRECTION_JWT_SECRET=        # [secret]
LIVEKIT_AGENT_NAME=                 # [optional]  has a built-in default
TOKEN_SERVER_URL=                   # [optional]  LiveKit token server base
TOKEN_SERVER_TIMEOUT_MS=            # [optional]

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LEVELUP_APP_URL=                    # [optional]  default https://levelup.masaischool.com
TZ=                                 # [optional]  process timezone
